{
  "type": "object",
  "required": [
    "title", "summary", "fullStory", "theme", "setting",
    "openingHook", "choices", "cliffhanger",
    "uniqueTags", "worldStateRef", "npcsRef", "style"
  ],
  "properties": {
    "title": { "type": "string", "maxLength": 80 },
    "summary": { "type": "string", "maxLength": 240 },
    "fullStory": { "type": "string" },
    "theme": { "type": "string" },
    "setting": { "type": "string" },
    "openingHook": { "type": "string", "maxLength": 160 },
    "worldStateRef": { "type": "string" },
    "npcsRef": { "type": "string" },
    "uniqueTags": {
      "type": "array", "minItems": 3, "maxItems": 6,
      "items": { "type": "string" }
    },
    "style": {
      "type": "object",
      "required": ["voice", "sensoryFocus", "narrativeDevice", "weirdness", "seed", "forbiddenPhrases"],
      "additionalProperties": false,
      "properties": {
        "voice": { "type": "string", "enum": ["lyrical-minimal", "noir-clipped", "mythic-register", "reportage"] },
        "sensoryFocus": { "type": "string", "enum": ["tactile", "olfactory", "auditory", "kinesthetic"] },
        "narrativeDevice": { "type": "string", "enum": ["second-person imperative", "found log", "stage directions", "prayer"] },
        "weirdness": { "type": "integer", "minimum": 1, "maximum": 5 },
        "seed": { "type": "string" },
        "forbiddenPhrases": { "type": "array", "items": { "type": "string" }, "maxItems": 12 }
      }
    },
    "choices": {
      "type": "array", "minItems": 3, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text", "hint", "consequence"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string", "maxLength": 120 },
          "hint": { "type": "string", "maxLength": 140 },
          "consequence": { "type": "string" }
        }
      }
    },
    "cliffhanger": { "type": "string" }
  },
  "additionalProperties": false
} 